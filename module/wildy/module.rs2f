/*@ define:module:wildy
name: 'PvM: wildy'
description: |
  Provides filtering for wildy mobs.
*/

#define CONST_AREA_CHAOSTEMPLE [3212,3586,0,3263,3636,0]
#define CONST_ELDERCHAOSDRUID_RULE(_cond) rule (area:CONST_AREA_CHAOSTEMPLE && (_cond))
#define CONST_ZOMBIEPIRATE_RULE(_cond) rule (area:CONST_AREA_CHAOSTEMPLE && (_cond))

/*@ define:input
type: boolean
group: Elder Chaos druid
label: Hide coin drops
*/
#define VAR_ELDERCHAOSDRUIDS_HIDECOINS true
CONST_ELDERCHAOSDRUID_RULE (VAR_ELDERCHAOSDRUIDS_HIDECOINS && name:"coins" && quantity:<=250) {
  hidden = true;
}

/*@ define:input
type: enumlist
label: 'Hide drops: 100%'
group: Elder Chaos druid
enum: ["bones"]
*/
#define VAR_ELDERCHAOSDRUID_ENUMLIST_FILTER_100 ["bones"]
CONST_ELDERCHAOSDRUID_RULE (name:VAR_ELDERCHAOSDRUID_ENUMLIST_FILTER_100) {
    hidden = true;
}

/*@ define:input
type: enumlist
label: 'Hide drops: Zamorak robes'
group: Elder Chaos druid
enum: ["zamorak monk top","zamorak monk bottom","elder chaos hood","elder chaos robe", "elder chaos top"]
*/
#define VAR_ELDERCHAOSDRUID_ENUMLIST_FILTER_ZAMORAKROBES ["zamorak monk top","zamorak monk bottom"]
CONST_ELDERCHAOSDRUID_RULE (name:VAR_ELDERCHAOSDRUID_ENUMLIST_FILTER_ZAMORAKROBES) {
    hidden = true;
}

